From 72e4f0382c8f68c99180011e3fd28381df32b0e9 Mon Sep 17 00:00:00 2001
From: mojyack <mojyack@gmail.com>
Date: Fri, 14 Aug 2026 10:54:33 +0900
Subject: [PATCH 1/3] Tegra210: do not touch CL-DVFS while it is in reset

The CL-DVFS block only answers on the bus while peripheral 155
(dfll_ref/dfll_soc, CAR bank W bit 27) is clocked and out of reset.
Touching it otherwise hangs the CPU on the APB, and it takes the whole
System Suspend entry down with it - the board goes silent with no way
back.

Mainline Linux gets there: tegra124-dfll asserts both the DVCO and the
DFLL peripheral reset in tegra_dfll_suspend(), so by the time PSCI
SYSTEM_SUSPEND reaches us the block is already in reset. Downstream's
DFLL driver leaves it alone, which is why L4T never hit this.

A DFLL in reset is disabled and cannot be driving the CPU regulator,
which is the only thing the open-loop write guards against, so there is
nothing left to do but record the PMIC type.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017fdordhuaYe3SNiccSSKBW
---
 plat/nvidia/tegra/include/t210/tegra_def.h    |  4 +++
 .../tegra/soc/t210/plat_psci_handlers.c       | 25 +++++++++++++++++++
 2 files changed, 29 insertions(+)

diff --git a/plat/nvidia/tegra/include/t210/tegra_def.h b/plat/nvidia/tegra/include/t210/tegra_def.h
index 2db846e..c26ed07 100644
--- a/plat/nvidia/tegra/include/t210/tegra_def.h
+++ b/plat/nvidia/tegra/include/t210/tegra_def.h
@@ -129,6 +129,10 @@
 #define  IRAM_D_LOCK_BIT		(U(1) << 23)
 #define  IRAM_C_LOCK_BIT		(U(1) << 22)
 #define  IRAM_B_LOCK_BIT		(U(1) << 21)
+#define TEGRA_RST_DEVICES_W		U(0x35C)
+#define TEGRA_CLK_OUT_ENB_W		U(0x364)
+/* peripheral 155 = dfll_ref/dfll_soc, i.e. the CL-DVFS block */
+#define  DFLL_PERIPH_BIT		(U(1) << 27)
 #define TEGRA_CLK_SOURCE_UARTA		U(0x178)
 #define TEGRA_CLK_SOURCE_UARTB		U(0x17C)
 #define TEGRA_CLK_SOURCE_UARTC		U(0x1A0)
diff --git a/plat/nvidia/tegra/soc/t210/plat_psci_handlers.c b/plat/nvidia/tegra/soc/t210/plat_psci_handlers.c
index 4748639..58c1abd 100644
--- a/plat/nvidia/tegra/soc/t210/plat_psci_handlers.c
+++ b/plat/nvidia/tegra/soc/t210/plat_psci_handlers.c
@@ -210,6 +210,31 @@ static void tegra_soc_cpu_prepare_pmic(void) {
 	uint32_t cfg;
 	uint32_t val;
 
+	/*
+	 * The CL-DVFS block only answers on the bus while peripheral 155
+	 * (dfll_ref/dfll_soc, CAR bank W bit 27) is clocked and out of reset;
+	 * touching it otherwise hangs the CPU on the APB and takes the whole
+	 * System Suspend entry down with it.
+	 *
+	 * That is not hypothetical here. Mainline Linux's tegra124-dfll driver
+	 * asserts both the DVCO and the DFLL peripheral reset in its system
+	 * suspend callback (tegra_dfll_suspend(), "DFLL is disabled and reset
+	 * during suspend and resume"), so by the time PSCI SYSTEM_SUSPEND
+	 * reaches us the block is already in reset. Downstream's DFLL driver
+	 * leaves it alone, which is why this was never hit on L4T.
+	 *
+	 * A DFLL that is in reset is disabled and cannot be writing anything
+	 * to the CPU regulator, which is the only reason for the open-loop
+	 * write below - so there is nothing to do but record the PMIC type.
+	 */
+	val = mmio_read_32(TEGRA_CAR_RESET_BASE + TEGRA_CLK_OUT_ENB_W);
+	cfg = mmio_read_32(TEGRA_CAR_RESET_BASE + TEGRA_RST_DEVICES_W);
+	if (((val & DFLL_PERIPH_BIT) == 0U) || ((cfg & DFLL_PERIPH_BIT) != 0U)) {
+		/* CPU rail is driven over I2C on any board that gets here */
+		tegra_pmc_write_32(PMC_SCRATCH201, 0x2);
+		return;
+	}
+
 	/*
 	 * When disabled, DFLL loses its state. Enable
 	 * open loop state for the DFLL as we dont want
-- 
